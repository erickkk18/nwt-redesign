# MongoDB connection string
# Local-by-Flywheel ships with MySQL, so MongoDB needs to run separately.
# Quickest: Docker (`docker run -d --name nwt-mongo -p 27017:27017 mongo:7`)
# or install MongoDB Community Edition.
DATABASE_URI=mongodb://127.0.0.1:27017/nwt_payload

# Payload secret — generate with:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace_me_with_64_random_chars

# Absolute path to the WordPress uploads folder on this machine.
# Backslashes are fine — fs.readFileSync handles both on Windows.
WP_UPLOADS_PATH=C:\Users\azerty\Local Sites\nwt\app\public\wp-content\uploads

# Path to the WordPress XML export (relative to project root or absolute).
# Generate via WP admin → Tools → Export → All content.
WP_EXPORT_PATH=./wp-export/export.xml

# Vercel Blob storage — required in production to host uploaded media.
# Provision: Vercel dashboard → Project → Storage → Create Blob store.
# Vercel auto-injects this var on deploys; for local migration scripts run
# `vercel env pull .env.local` or paste the token here.
# Leave EMPTY in local dev to keep using the on-disk media/ folder.
BLOB_READ_WRITE_TOKEN=
